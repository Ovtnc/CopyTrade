generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MarketplaceType {
  TRENDYOL
  HEPSIBURADA
}

enum ProductSyncStatus {
  DRAFT
  QUEUED
  PROCESSING
  SUCCESS
  FAILED
}

enum LogLevel {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum MarginType {
  PERCENTAGE
  FIXED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  fullName     String?
  passwordHash String?
  timezone     String        @default("Europe/Istanbul")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  products     Product[]
  marketplaces Marketplace[]
  mappings     Mapping[]
  logs         Log[]

  @@map("users")
}

model Marketplace {
  id         String          @id @default(cuid())
  userId     String
  type       MarketplaceType
  storeName  String
  apiBaseUrl String?
  apiKey     String?
  apiSecret  String?
  isActive   Boolean         @default(true)
  lastSyncAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  products   Product[]
  mappings   Mapping[]
  logs       Log[]

  @@unique([userId, type, storeName])
  @@index([userId, type])
  @@map("marketplaces")
}

model Mapping {
  id              String      @id @default(cuid())
  userId          String
  marketplaceId   String
  name            String      @default("Default Mapping")
  sourceSchema    Json?
  targetSchema    Json?
  fieldMappings   Json
  isAiGenerated   Boolean     @default(false)
  confidenceScore Float?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketplace     Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  products        Product[]

  @@index([userId, marketplaceId])
  @@map("mappings")
}

model Product {
  id                   String            @id @default(cuid())
  userId               String
  marketplaceId        String
  mappingId            String?
  sourceSku            String
  externalSku          String?
  sourceTitle          String
  optimizedTitle       String?
  sourceDescription    String?
  optimizedDescription String?
  rawXml               Json
  price                Decimal           @db.Decimal(12, 2)
  stock                Int
  currency             String            @default("TRY")
  marginType           MarginType        @default(PERCENTAGE)
  marginValue          Decimal           @default(0) @db.Decimal(8, 2)
  finalPrice           Decimal           @db.Decimal(12, 2)
  syncStatus           ProductSyncStatus @default(DRAFT)
  lastSyncedAt         DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketplace          Marketplace       @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  mapping              Mapping?          @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  logs                 Log[]

  @@index([userId, syncStatus])
  @@index([marketplaceId, externalSku])
  @@map("products")
}

model Log {
  id            String      @id @default(cuid())
  userId        String
  productId     String?
  marketplaceId String?
  level         LogLevel    @default(INFO)
  message       String
  context       Json?
  jobId         String?
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  marketplace   Marketplace? @relation(fields: [marketplaceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([productId, createdAt])
  @@map("logs")
}
